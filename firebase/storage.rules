rules_version = '2';

// ============================================================
// OPTIMUSCLE - Storage Security Rules
// ============================================================
// Pour les photos de profil, captures de progression, etc.

service firebase.storage {
  match /b/{bucket}/o {

    // Avatars utilisateurs
    match /avatars/{userId}/{fileName} {
      // Tout le monde peut lire les avatars (publics)
      allow read: if true;

      // Écriture : uniquement par le propriétaire
      // Avec validation taille (max 2MB) et type (images uniquement)
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 2 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Photos de progression (privées)
    match /progress/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Tout le reste = bloqué
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
